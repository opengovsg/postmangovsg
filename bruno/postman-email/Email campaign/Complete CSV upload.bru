meta {
  name: Complete CSV upload
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/campaign/{{campaignId}}/email/upload/complete
  body: json
  auth: inherit
}

body:json {
  {
    "transaction_id": "<transaction_id from upload start>",
    "filename": "recipients.csv",
    "etag": "<ETag from S3 PUT>"
  }
}
