{
  "name": "shared",
  "description": "Shared modules for Postman",
  "main": "build/index.js",
  "scripts": {
    "dev": "npm run postbuild && tsc --build tsconfig.build.json -w",
    "build": "rimraf build && tsc --build tsconfig.build.json --clean && tsc -p tsconfig.build.json",
    "lint-no-fix": "tsc --composite false --noEmit && oxlint && oxfmt --check '**/*.{js,ts}'",
    "lint": "tsc --composite false --noEmit && oxlint --fix && oxfmt '**/*.{js,ts}'",
    "postbuild": "npm run copy-assets",
    "copy-assets": "copyfiles -u 1 src/**/*.mustache build",
    "test": "jest",
    "precommit": "lint-staged"
  },
  "types": "build/index",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opengovsg/postmangovsg.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/opengovsg/postmangovsg/issues"
  },
  "homepage": "https://github.com/opengovsg/postmangovsg#readme",
  "devDependencies": {
    "@types/cheerio": "0.22.31",
    "@types/jest": "27.5.2",
    "@types/lodash": "4.14.182",
    "@types/mustache": "4.1.3",
    "@types/node": "14.18.21",
    "copyfiles": "2.4.1",
    "jest": "27.5.1",
    "lint-staged": "11.2.6",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rimraf": "3.0.2",
    "ts-jest": "27.1.5",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "@types/nodemailer": "6.4.0",
    "axios": "1.20.0",
    "cheerio": "1.0.0-rc.10",
    "dd-trace": "6.21.0",
    "libphonenumber-js": "1.10.6",
    "lodash": "4.17.21",
    "mustache": "4.2.0",
    "nodemailer": "7.0.11",
    "opentracing": "0.14.7",
    "twilio": "4.19.3",
    "xss": "1.0.13"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
